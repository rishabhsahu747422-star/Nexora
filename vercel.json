{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd Client && npm run build",
  "outputDirectory": "Client/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://nexora-ikwc.onrender.com/api/$1"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
