# Nexora Client Environment Configuration Template
# Copy this file to .env.local to configure local overrides.

# API Base URL (defaults to http://localhost:3000/api if not specified)
VITE_API_BASE_URL=http://localhost:3000/api

# Realtime WebSocket Gateway URL (defaults to http://localhost:3000 if not specified)
VITE_SOCKET_URL=http://localhost:3000

# WebRTC ICE / TURN Server Configuration
# STUN servers (Google STUN) are configured by default for peer-to-peer NAT traversal.
# In restrictive enterprise/carrier NATs or symmetric firewall environments,
# configure a TURN relay server with secure time-limited credentials:
# Example:
# VITE_TURN_SERVER_URL=turn:turn.example.com:3478?transport=udp
# VITE_TURN_USERNAME=nexora_relay
# VITE_TURN_CREDENTIAL=secure_temporary_token
